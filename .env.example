# uid/gid the container user runs as; match your host user (id -u / id -g)
PUID=1000
PGID=1000
# container timezone
TZ=UTC
# host directory holding your repos
WORKSPACE_HOST=./workspace
# path inside the container; set equal to the host path if you touch repos from both sides (Paseo stores absolute paths)
WORKSPACE=/workspace
# host port, bound to 127.0.0.1 only; put a TLS reverse proxy in front
PORT=6767
# public https URL your reverse proxy serves; its host is allowed by the daemon and used by `pair`
PUBLIC_URL=
# daemon password, required unless ALLOW_NO_PASSWORD=1
PASEO_PASSWORD=
# 1 boots without a password; only on a network you fully trust
ALLOW_NO_PASSWORD=0
# base URL for dev server previews, e.g. https://dev.example.com serves <service>.dev.example.com; empty disables
SERVICE_BASE_URL=
# proxies whose X-Forwarded-* headers are trusted (Express trust proxy syntax); empty keeps loopback,uniquelocal
TRUSTED_PROXIES=
# image to run; override to pin a version, e.g. ghcr.io/xaroth/paseo-harness:v0.1.0
IMAGE=ghcr.io/xaroth/paseo-harness:latest
# 1 starts sshd inside the container (key auth, user code). Drop your public key in the config volume at ssh/authorized_keys
SSHD=0
# GitHub user whose public keys are fetched into ssh/authorized_keys.github at each start
SSH_KEYS_FROM_GITHUB=
# where port 22 of the container is published; VS Code Remote SSH connects here
SSH_BIND=127.0.0.1
SSH_PORT=2222
# 1 starts a D-Bus session bus and an unlocked gnome-keyring (Secret Service) for apps using the OS keyring.
# Throwaway: fixed password "harness", lives in the container. Not for real credentials
KEYRING=0
# fast tool updates: latest (newest release older than UPDATE_MIN_AGE), image (image versions only), pinned (PIN_* only)
UPDATE_CHANNEL=latest
# comma-separated tools kept up to date
UPDATE_TOOLS=paseo,claude,playwright-mcp,chrome-devtools-mcp
# minimum release age before a version is installed
UPDATE_MIN_AGE=24h
# how often to check for updates while running; 0 checks at start only
UPDATE_INTERVAL=6h
# seconds allowed per install before keeping the current version
UPDATE_TIMEOUT=120
# exact versions or npm tags per tool; empty follows UPDATE_CHANNEL
PIN_PASEO=
PIN_CLAUDE=
PIN_PLAYWRIGHT_MCP=
PIN_CHROME_DEVTOOLS_MCP=

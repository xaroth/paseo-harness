#!/usr/bin/env bash
# Keeps the fast tools current in the overlay (/cache/tools), which sits ahead
# of the image's /opt/tools on PATH. A failed resolve, install or verify keeps
# the active version. A new Paseo goes live once no agent is running.
# Usage: update [--once|--watch|--check|--rollback <tool>|--prune]
# jq and bash -c programs are single-quoted on purpose
# shellcheck disable=SC2016
set -uo pipefail

if [ "$(id -u)" = 0 ]; then
  exec gosu code "$0" "$@"
fi

# shellcheck source=docker/lib/tools.sh
source "$(dirname "$(readlink -f "$0")")/../lib/tools.sh"

RUN_DIR="${HARNESS_RUN_DIR:-/run/harness}"
LOCK="$RUN_DIR/update.lock"
OVL="$TOOLS_OVERLAY_ROOT"
IMG="$TOOLS_IMAGE_ROOT"
STATE="$OVL/state.json"
STAGE="$OVL/.tmp"
CHANNEL="${UPDATE_CHANNEL:-latest}"
UPDATE_TIMEOUT="${UPDATE_TIMEOUT:-120}"
IDLE_POLL="${UPDATE_IDLE_POLL:-60}"
VERIFY_TIMEOUT=30
IDLE_LIST_FAILURES=10
# npm's own resolver and semver, from the npm bundled with the node that runs the tools
NPM_MODS="$(dirname "$(readlink -f "$(command -v "$TOOLS_NODE")")")/../lib/node_modules/npm/node_modules"

# killed or removed on exit, so an interrupted run leaves no daemon, npm or stage dir behind
VERIFY_PID=
INSTALL_PID=
SLEEP_PID=
CLEANUP_DIRS=()
# stop_group <pgid>: TERM, up to 10 s grace, then KILL; npm keeps writing for a while after TERM
stop_group() {
  local i
  kill -TERM -- "-$1" 2>/dev/null || return 0
  for ((i = 0; i < 20; i++)); do kill -0 -- "-$1" 2>/dev/null || return 0; sleep 0.5; done
  kill -KILL -- "-$1" 2>/dev/null
  sleep 0.5
}
cleanup() {
  [ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null
  [ -n "$VERIFY_PID" ] && stop_group "$VERIFY_PID"
  [ -n "$INSTALL_PID" ] && stop_group "$INSTALL_PID"
  ((${#CLEANUP_DIRS[@]})) && rm -rf "${CLEANUP_DIRS[@]}"
  VERIFY_PID='' INSTALL_PID='' SLEEP_PID='' CLEANUP_DIRS=()
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# a foreground sleep would hold off the TERM trap until it ends; wait returns at once
nap() {
  sleep "$1" 9>&- &
  SLEEP_PID=$!
  wait "$SLEEP_PID"
  SLEEP_PID=
}

log() { printf '[update] %s\n' "$*" >&2; }
usage() { echo "usage: update [--once|--watch|--check|--rollback <tool>|--prune]"; }

# 90, 90s, 30m, 6h, 1d -> seconds
dur_seconds() {
  local n="${1%[smhd]}"
  [[ "$n" =~ ^[0-9]+$ ]] || return 1
  case "$1" in
    *d) echo $((n * 86400)) ;;
    *h) echo $((n * 3600)) ;;
    *m) echo $((n * 60)) ;;
    *) echo "$n" ;;
  esac
}

MIN_AGE="$(dur_seconds "${UPDATE_MIN_AGE:-24h}")" || { log "bad UPDATE_MIN_AGE '${UPDATE_MIN_AGE}'"; exit 2; }
INTERVAL="$(dur_seconds "${UPDATE_INTERVAL:-6h}")" || { log "bad UPDATE_INTERVAL '${UPDATE_INTERVAL}'"; exit 2; }
case "$CHANNEL" in latest|image|pinned) ;; *) log "bad UPDATE_CHANNEL '$CHANNEL' (latest|image|pinned)"; exit 2 ;; esac

selected_tools() {
  local t sel
  IFS=, read -ra sel <<<"${UPDATE_TOOLS:-paseo,claude,playwright-mcp,chrome-devtools-mcp}"
  for t in "${sel[@]}"; do
    t="${t// /}"
    [ -z "$t" ] && continue
    if tool_known "$t"; then echo "$t"; else log "unknown tool '$t' in UPDATE_TOOLS (known: ${TOOLS[*]})"; fi
  done
}

# fd 9 holds the lock; long-lived children get 9>&- so they cannot keep it
lock() {
  mkdir -p "$RUN_DIR"
  exec 9>>"$LOCK"
  flock "$@" 9
}
unlock() { flock -u 9; }

state_get() { [ -f "$STATE" ] && jq -r --arg t "$1" --arg k "$2" '.[$t][$k] // empty' "$STATE" 2>/dev/null; }

# state_set <tool> <jq object expr> [--arg name value]...
state_set() {
  local tool="$1" expr="$2" tmp
  shift 2
  mkdir -p "$OVL"
  [ -s "$STATE" ] && jq -e . "$STATE" >/dev/null 2>&1 || echo '{}' > "$STATE"
  tmp="$STATE.$$"
  jq --arg t "$tool" "$@" ".[\$t] = ((.[\$t] // {}) + $expr)" "$STATE" > "$tmp" && mv "$tmp" "$STATE"
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

record_error() {
  log "$1: $2"
  state_set "$1" '{last_error: $e, last_error_at: $at}' --arg e "$2" --arg at "$(now_iso)"
}

is_exact() { [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; }

cutoff() { ((MIN_AGE > 0)) && date -u -d "@$(($(date +%s) - MIN_AGE))" +%Y-%m-%dT%H:%M:%SZ; }

# spec <tool>: what to follow, empty means the image version
spec_of() {
  local pin_var
  pin_var="$(tool_pin_var "$1")"
  [ "$CHANNEL" = image ] && return 0
  if [ -n "${!pin_var:-}" ]; then echo "${!pin_var}"; return 0; fi
  [ "$CHANNEL" = latest ] && echo latest
  return 0
}

# resolve <tool> <spec>: newest version matching spec and published before the
# cutoff. npm view ignores --before, so pick with npm's own npm-pick-manifest.
resolve() {
  local tool="$1" spec="$2" before
  if is_exact "$spec"; then echo "${spec#v}"; return 0; fi
  before="$(cutoff)"
  timeout 30 npm view "${TOOL_PKG[$tool]}" versions time dist-tags --json 2>/dev/null |
    "$TOOLS_NODE" -e '
      const pick = require(process.argv[1] + "/npm-pick-manifest");
      const p = JSON.parse(require("fs").readFileSync(0, "utf8"));
      const versions = Object.fromEntries([].concat(p.versions).map(v => [v, { version: v }]));
      const opts = process.argv[3] ? { before: process.argv[3] } : {};
      console.log(pick({ versions, time: p.time, "dist-tags": p["dist-tags"] }, process.argv[2], opts).version);
    ' "$NPM_MODS" "$spec" "$before" 2>/dev/null
}

# semver_cmp <a> <op> <b>, op is lt or lte; false when either is not a version
semver_cmp() {
  [ -n "$1" ] && [ -n "$3" ] &&
    "$TOOLS_NODE" -e 'const s = require(process.argv[1] + "/semver");
      process.exit(s.valid(process.argv[2]) && s.valid(process.argv[4]) && s[process.argv[3]](process.argv[2], process.argv[4]) ? 0 : 1)' \
      "$NPM_MODS" "$1" "$2" "$3"
}

free_port() {
  "$TOOLS_NODE" -e 'const s=require("net").createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})'
}

# Throwaway daemon on its own home, config and loopback port; nothing real is touched.
verify_paseo() {
  local dir="$1" entry port tmp pid ok=1 i
  entry="$(tool_bin_entry "$dir/lib/node_modules/${TOOL_PKG[paseo]}" paseo)" || { echo "no paseo bin entry"; return 1; }
  port="$(free_port)" || return 1
  tmp="$(mktemp -d)"
  CLEANUP_DIRS+=("$tmp")
  mkdir -p "$tmp/home" "$tmp/claude" "$tmp/models"
  env -i PATH="$PATH" HOME="$tmp" PASEO_HOME="$tmp/home" CLAUDE_CONFIG_DIR="$tmp/claude" \
    PASEO_LOCAL_MODELS_DIR="$tmp/models" PASEO_LISTEN="127.0.0.1:$port" PASEO_RELAY_ENABLED=false \
    setsid "$TOOLS_NODE" --disable-warning=DEP0040 "$entry" daemon run >"$tmp/log" 2>&1 9>&- &
  pid=$!
  VERIFY_PID=$pid
  for ((i = 0; i < VERIFY_TIMEOUT; i++)); do
    if curl -fsS --max-time 2 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then ok=0; break; fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  stop_group "$pid"
  wait "$pid" 2>/dev/null
  VERIFY_PID=
  ((ok == 0)) || { echo "throwaway daemon did not answer /api/health within ${VERIFY_TIMEOUT}s"; tail -n 5 "$tmp/log"; }
  rm -rf "$tmp"
  return "$ok"
}

verify() {
  local tool="$1" dir="$2" tmp out rc
  if [ "$tool" = paseo ]; then verify_paseo "$dir"; return; fi
  tmp="$(mktemp -d)"
  out="$(tool_install_env; CLAUDE_CONFIG_DIR="$tmp" timeout "$VERIFY_TIMEOUT" "$dir/bin/${TOOL_BIN[$tool]}" --version 2>&1 9>&-)"
  rc=$?
  rm -rf "$tmp"
  ((rc == 0)) || echo "$out" | tail -n 5
  return "$rc"
}

# install <tool> <ver> <timeout> [npm args]: stage, verify, move into place
install() {
  local tool="$1" ver="$2" limit="$3" tmp dest rc
  shift 3
  dest="$OVL/$tool/$ver"
  mkdir -p "$STAGE" "$OVL/$tool"
  tmp="$(mktemp -d "$STAGE/$tool-$ver.XXXXXX")" || { INSTALL_ERR="cannot create a stage dir in $STAGE"; return 1; }
  CLEANUP_DIRS+=("$tmp")
  chmod 0755 "$tmp"
  log "$tool: installing $ver"
  # own session, so the trap and the timeout path can stop npm and its children as a group
  setsid timeout "$limit" bash -c 'source "$1"; shift; tool_install_env; tool_npm_install "$@"' _ \
    "$(dirname "$(readlink -f "$0")")/../lib/tools.sh" "$tmp/pkg" "$tool" "$ver" --loglevel=error "$@" \
    >"$tmp/npm.log" 2>&1 9>&- &
  INSTALL_PID=$!
  wait "$INSTALL_PID"
  rc=$?
  # timeout only waits for its direct child
  stop_group "$INSTALL_PID"
  INSTALL_PID=
  if ((rc != 0)); then
    INSTALL_ERR="npm install $ver failed or timed out after ${limit}s: $(tail -n 3 "$tmp/npm.log" | tr '\n' ' ')"
    rm -rf "$tmp"
    return 1
  fi
  # not in $(...): verify_paseo must set VERIFY_PID in this shell for the trap
  if ! verify "$tool" "$tmp/pkg" >"$tmp/verify.log" 2>&1; then
    INSTALL_ERR="$ver failed verification: $(tr '\n' ' ' <"$tmp/verify.log")"
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$dest"
  mv -T "$tmp/pkg" "$dest"
  rm -rf "$tmp"
}

# without a password, paseo ls authenticates through $PASEO_HOME/local-credential
load_password() {
  # shellcheck source=/dev/null
  if [ -z "${PASEO_PASSWORD:-}" ] && [ -r "$RUN_DIR/env" ]; then source "$RUN_DIR/env"; fi
}

daemon_pid() {
  local pid
  pid="$(cat "$RUN_DIR/daemon.pid" 2>/dev/null)" || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

# CLI=(...) of the running daemon's version, so ls speaks its protocol; harness-run starts it with a resolved path
daemon_cli() {
  local entry
  entry="$(tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null | grep -m1 '/bin/paseo$')"
  if [ -n "$entry" ] && [ -f "$entry" ]; then CLI=("$TOOLS_NODE" --disable-warning=DEP0040 "$entry"); else CLI=(paseo); fi
}

# Restart the running daemon onto the active Paseo once no agent is busy.
restart_paseo() {
  local pid out busy fails=0 CLI
  pid="$(daemon_pid)" || { log "paseo: daemon not running, the new version applies at its next start"; return 0; }
  load_password
  daemon_cli "$pid"
  while :; do
    if out="$("${CLI[@]}" ls -a -g --json 2>&1 9>&-)" &&
      busy="$(jq -e '[.[] | select(.status == "running" or .status == "initializing")] | length' <<<"$out" 2>/dev/null)"; then
      fails=0
      ((busy == 0)) && break
      log "paseo: $busy agent(s) running, checking again in ${IDLE_POLL}s"
    else
      fails=$((fails + 1))
      log "paseo: cannot list agents ($(tr '\n' ' ' <<<"$out" | cut -c1-200))"
      if ((fails >= IDLE_LIST_FAILURES)); then
        log "paseo: listing failed $fails times in a row, giving up; the new version applies at the next start"
        return 0
      fi
    fi
    nap "$IDLE_POLL"
    # harness-run restarted it meanwhile, which picks up the active version
    [ "$(daemon_pid)" = "$pid" ] || { log "paseo: daemon restarted meanwhile"; return 0; }
  done
  log "paseo: idle, restarting daemon (pid $pid)"
  touch "$RUN_DIR/restart"
  kill -TERM "$pid"
}

skipped() { [ -f "$STATE" ] && jq -e --arg t "$1" --arg v "$2" '(.[$t].skip // []) | index($v) != null' "$STATE" >/dev/null 2>&1; }

# follow_image <tool> <reason>: drop the overlay links so the image version is active
follow_image() {
  local tool="$1" img cur
  img="$(tool_version "$IMG" "$tool")"
  cur="$(tool_version "$OVL" "$tool")"
  if [ -n "$cur" ]; then
    log "$tool: $2, dropping overlay $cur for image $img"
    tool_unlink "$OVL" "$tool"
    CHANGED=1
  fi
  state_set "$tool" '{active: $v}' --arg v "$img"
}

# update_tool <tool> <deadline epoch or 0>; sets CHANGED=1 when the active version moved
update_tool() {
  local tool="$1" deadline="$2" spec ver img cur limit exact=0 before_args=()
  img="$(tool_version "$IMG" "$tool")"
  cur="$(tool_version "$OVL" "$tool")"
  spec="$(spec_of "$tool")"
  if [ -z "$spec" ]; then
    follow_image "$tool" "following the image"
    state_set "$tool" '{resolved: $v, last_error: null}' --arg v "$img"
    return 0
  fi
  is_exact "$spec" && exact=1
  # only an exact pin or a rollback from the image version may hold the overlay below
  # the image; the image itself has no min age
  if [ -n "$cur" ] && semver_cmp "$cur" lt "$img" && ! { ((exact)) && [ "${spec#v}" = "$cur" ]; } &&
    ! skipped "$tool" "$img"; then
    follow_image "$tool" "overlay $cur is older than the image"
    cur=
  fi
  if ! ver="$(resolve "$tool" "$spec")" || [ -z "$ver" ]; then
    record_error "$tool" "cannot resolve ${TOOL_PKG[$tool]}@$spec (min age ${UPDATE_MIN_AGE:-24h}), keeping ${cur:-image $img}"
    return 1
  fi
  if ! ((exact)) && skipped "$tool" "$ver"; then
    log "$tool: $ver was rolled back, keeping ${cur:-image $img} until another version resolves"
    return 0
  fi
  state_set "$tool" '{resolved: $v, skip: null}' --arg v "$ver"

  if [ "$ver" = "$img" ] || { ! ((exact)) && semver_cmp "$ver" lte "$img"; }; then
    follow_image "$tool" "image $img is at least $ver"
    [ -n "$cur" ] || log "$tool: image $img is current$([ "$ver" != "$img" ] && echo " (newer than $ver)")"
    state_set "$tool" '{last_error: null}'
    return 0
  fi
  if [ "$ver" = "$cur" ]; then
    # idempotent; repairs a bin link an interrupted first activation left out
    tool_activate "$OVL" "$tool" "$ver"
    log "$tool: overlay $ver is current"
    state_set "$tool" '{active: $v, last_error: null}' --arg v "$ver"
    return 0
  fi

  if [ ! -d "$OVL/$tool/$ver" ]; then
    limit="$UPDATE_TIMEOUT"
    if ((deadline > 0)); then
      local left=$((deadline - $(date +%s)))
      ((left < limit)) && limit="$left"
      if ((limit <= 0)); then
        log "$tool: start budget used up, $ver installs at the next check"
        return 0
      fi
    fi
    ((exact)) || [ -z "$(cutoff)" ] || before_args=("--before=$(cutoff)")
    if ! install "$tool" "$ver" "$limit" "${before_args[@]}"; then
      record_error "$tool" "$INSTALL_ERR; keeping ${cur:-image $img}"
      return 1
    fi
    state_set "$tool" '{installed_at: $at}' --arg at "$(now_iso)"
  fi
  tool_switch "$OVL" "$tool" "$ver"
  log "$tool: now $ver (was ${cur:-image $img})"
  state_set "$tool" '{active: $v, last_error: null}' --arg v "$ver"
  CHANGED=1
}

# cycle <deadline> <restart 0|1>
cycle() {
  local deadline="$1" restart="$2" tool rc=0 paseo_changed=0 sel
  if [ "$CHANNEL" = image ]; then
    for tool in "${TOOLS[@]}"; do
      CHANGED=0
      update_tool "$tool" 0 || rc=1
      [ "$tool" = paseo ] && paseo_changed="$CHANGED"
    done
  else
    sel=" $(selected_tools | tr '\n' ' ')"
    for tool in "${TOOLS[@]}"; do
      [[ "$sel" == *" $tool "* ]] && continue
      CHANGED=0
      follow_image "$tool" "not in UPDATE_TOOLS"
      state_set "$tool" '{last_error: null}'
      [ "$tool" = paseo ] && paseo_changed="$CHANGED"
    done
    while read -r tool; do
      if ((deadline > 0 && $(date +%s) >= deadline)); then
        log "start budget of ${UPDATE_START_BUDGET:-180}s used up, skipping the rest"
        break
      fi
      CHANGED=0
      update_tool "$tool" "$deadline" || rc=1
      [ "$tool" = paseo ] && paseo_changed="$CHANGED"
    done < <(selected_tools)
  fi
  ((paseo_changed && restart)) && restart_paseo
  return "$rc"
}

check() {
  local tool spec img cur prev ver err sel note
  printf 'channel %s, min age %s\n' "$CHANNEL" "${UPDATE_MIN_AGE:-24h}"
  sel=" $(selected_tools 2>/dev/null | tr '\n' ' ')"
  for tool in "${TOOLS[@]}"; do
    img="$(tool_version "$IMG" "$tool")"
    cur="$(tool_version "$OVL" "$tool")"
    prev="$(tool_version "$OVL" "$tool" previous)"
    spec="$(spec_of "$tool")"
    note=
    if [ "$CHANNEL" != image ] && [[ "$sel" != *" $tool "* ]]; then
      ver="$img"
      note=' (not updated)'
    elif [ -z "$spec" ]; then
      ver="$img"
    else
      ver="$(resolve "$tool" "$spec")" || ver="unresolved"
    fi
    err="$(state_get "$tool" last_error)"
    [ -z "$note" ] && [ "$ver" != "${cur:-$img}" ] && note=' (update pending)'
    printf '%-20s image %-10s overlay %-10s previous %-10s target %-10s%s%s\n' "$tool" "${img:--}" \
      "${cur:--}" "${prev:--}" "${ver:--}" "$note" "${err:+ last error: $err}"
  done
}

# previous if there is one, else back to the image. The version left is skipped
# by later checks until another version resolves.
rollback() {
  local tool="$1" cur prev img
  tool_known "$tool" || { log "unknown tool '$tool' (known: ${TOOLS[*]})"; return 2; }
  # the next cycle would drop the rollback again
  if [ "$CHANNEL" = image ]; then
    log "UPDATE_CHANNEL=image: all tools follow the image"
    return 2
  fi
  if ! selected_tools | grep -qx "$tool"; then
    log "$tool is not in UPDATE_TOOLS and follows the image"
    return 2
  fi
  img="$(tool_version "$IMG" "$tool")"
  cur="$(tool_version "$OVL" "$tool")"
  prev="$(tool_version "$OVL" "$tool" previous)"
  [ -d "$OVL/$tool/$prev" ] || prev=
  if [ -n "$prev" ] && [ "$prev" != "$cur" ]; then
    tool_activate "$OVL" "$tool" "$prev"
    rm -f "$OVL/$tool/previous"
    log "$tool: rolled back to $prev (was ${cur:-image $img})"
    state_set "$tool" '{active: $v}' --arg v "$prev"
  elif [ -n "$cur" ]; then
    rm -f "$OVL/$tool/current" "$OVL/$tool/previous" "$OVL/bin/${TOOL_BIN[$tool]}"
    log "$tool: rolled back to image $img (was $cur)"
    state_set "$tool" '{active: $v}' --arg v "$img"
  else
    log "$tool: already on the image version ${img:--}, nothing to roll back to"
    return 1
  fi
  state_set "$tool" '{skip: (((.[$t].skip // []) + [$s]) | unique)}' --arg s "${cur:-$img}"
  [ "$tool" = paseo ] && restart_paseo
  return 0
}

prune() {
  local tool d cur prev
  # the running daemon may still use a version that is neither current nor previous
  if daemon_pid >/dev/null; then
    log "paseo daemon is running; --prune only runs at start"
    return 1
  fi
  for tool in "${TOOLS[@]}"; do
    [ -d "$OVL/$tool" ] || continue
    cur="$(tool_version "$OVL" "$tool")"
    prev="$(tool_version "$OVL" "$tool" previous)"
    for d in "$OVL/$tool"/*/; do
      d="${d%/}"
      [ -d "$d" ] && [ ! -L "$d" ] || continue
      case "${d##*/}" in "$cur"|"$prev") continue ;; esac
      log "$tool: pruning ${d##*/}"
      rm -rf "$d"
    done
  done
  if [ -d "$STAGE" ]; then rm -rf "${STAGE:?}"/* "$STAGE"/.[!.]* 2>/dev/null; fi
  return 0
}

watch() {
  if ((INTERVAL == 0)); then
    log "UPDATE_INTERVAL=0, no periodic checks"
    return 0
  fi
  while :; do
    nap "$INTERVAL"
    if lock -n; then
      cycle 0 1
      unlock
    else
      log "another update is running, skipping this check"
    fi
  done
}

case "${1:-}" in
  --once)
    budget="${UPDATE_START_BUDGET:-180}"
    lock -w "$budget" || { log "lock busy for ${budget}s, skipping"; exit 1; }
    cycle "$(($(date +%s) + budget))" 0 ;;
  --watch) watch ;;
  --check) check ;;
  --rollback)
    [ -n "${2:-}" ] || { usage >&2; exit 2; }
    lock
    rollback "$2" ;;
  --prune)
    lock
    prune ;;
  "")
    lock -n || { log "another update is running, waiting for it"; lock; }
    cycle 0 1 ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
